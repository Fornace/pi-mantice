{
  "name": "pi-mantice",
  "version": "1.2.0",
  "description": "Mantice gateway integration for Pi: live model catalog with capability fields, class-aware metadata, two-stage compaction (mechanical RTK-style pruning plus Pi native AI summaries), canonical overflow recovery, and first-install setup",
  "type": "module",
  "license": "MIT",
  "author": "Francesco Frapporti <effedue@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fornace/pi-mantice.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "mantice",
    "fornace",
    "models",
    "compaction"
  ],
  "files": [
    "extensions",
    "src",
    "tools",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:session-wire": "node tools/verify-session-wire.mjs",
    "test:fast-wire": "node tools/verify-fast-wire.mjs",
    "test:session-recovery": "python3 tools/verify-session-recovery.py",
    "snapshot": "node tools/refresh-snapshot.mjs",
    "audit": "node tools/audit.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:package": "node .github/scripts/verify-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test",
    "e2e": "python3 tools/e2e-compact.py"
  },
  "dependencies": {
    "pi-frontier": "^1.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^24.13.3",
    "typebox": "1.3.7",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.18"
  }
}
